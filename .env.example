# Valores por defecto para ejecutar el servicio.
# Docker Compose carga este archivo directamente para que el proyecto
# pueda levantarse desde un clon limpio sin crear archivos adicionales.
# Si ejecutas la API fuera de Docker, puedes copiarlo a .env y modificar sus valores.

# Carpeta donde vive el modelo serializado (relativa al working dir del contenedor)
APP_MODEL_DIR=models

# Nombre del archivo del pipeline serializado
APP_MODEL_FILENAME=model.joblib

# Nombre del archivo de metadatos del modelo
APP_METADATA_FILENAME=metadata.json

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# Umbral de decisión por defecto para clasificar churn (0.0 - 1.0)
APP_DEFAULT_THRESHOLD=0.5
